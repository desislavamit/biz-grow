{
  "name": "bizgrow-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "push:out": "bash ../scripts/push-out.sh",
    "preview": "serve out -l 3000",
    "build:node": "BUILD_MODE=node next build && cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start:node": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  }
}
